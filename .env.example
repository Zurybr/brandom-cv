# Supabase configuration
# ------------------------------------------------------------------
# Get all values from: Supabase Dashboard -> your project ->
# Project Settings (gear icon) -> API
#
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored; this `.env.example` is safe to commit.

# Project URL. Safe to expose to the browser (it is public).
# Dashboard -> API -> "Project URL"
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon public key. Safe to expose; access is protected by Row Level Security (RLS).
# Dashboard -> API -> "Project API keys" -> "anon public"
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key. SECRET. Bypasses RLS. SERVER-ONLY.
# NEVER expose to the browser, NEVER prefix with PUBLIC_, NEVER commit it.
# Dashboard -> API -> "Project API keys" -> "service_role"
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string (for Drizzle/Prisma/pg, not the JS client).
# The database password lives inside it, replacing [YOUR-PASSWORD].
# Copy the exact string from: Dashboard -> Project Settings -> Database ->
#   "Connection string" -> "Transaction pooler" (port 6543, recommended for apps).
# The password was set at project creation and is NOT shown again; if lost,
# reset it at: Dashboard -> Project Settings -> Database -> "Database password".
# SECRET. SERVER-ONLY. NEVER expose to the browser, NEVER prefix with PUBLIC_.
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

