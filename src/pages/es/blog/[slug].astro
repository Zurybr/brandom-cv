---
import { getCollection, render } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import { computeReadingTime } from '@/lib/utils'
import BaseImg from '@/components/ui/base-img.astro'
import type { Lang } from '@/i18n/ui'
import { getLocalizedPath, useTranslations } from '@/i18n/utils'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  const esPosts = posts.filter((post) => (post.data.lang || 'en') === 'es')
  return esPosts.map((post) => ({
    params: { slug: post.id.replace(/-es$/, '') },
    props: { post },
  }))
}

const lang: Lang = 'es'
const { post } = Astro.props
const { Content } = await render(post)

const readingTime = computeReadingTime(post.body || '', lang)

const formattedDate = new Date(post.data.date).toLocaleDateString('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})

const t = useTranslations(lang)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.date.toISOString(),
  inLanguage: lang,
  author: {
    '@type': 'Person',
    name: 'Brandom Ledesma',
    url: 'https://zurybr.github.io/brandom-cv/',
  },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
}
---

<Layout
  title={`${post.data.title} — Brandom Ledesma`}
  description={post.data.excerpt}
  ogType="article"
  ogPublishedTime={post.data.date.toISOString()}
  lang={lang}
  jsonLd={jsonLd}
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-16">
    <a
      href={getLocalizedPath('/blog', lang)}
      class="mb-8 inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline"
    >
      <span aria-hidden="true">←</span>
      {t('back.blog')}
    </a>
    <article>
      <header class="mb-8">
        <h1
          class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
        >
          {post.data.title}
        </h1>
        <div class="mt-3 flex items-center gap-4 text-sm text-muted-foreground">
          <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
          <span>{readingTime}</span>
        </div>
      </header>
      <div class="prose-content">
        <Content
          components={{
            h2: 'h2',
            h3: 'h3',
            p: 'p',
            pre: 'pre',
            code: 'code',
            ul: 'ul',
            ol: 'ol',
            blockquote: 'blockquote',
            a: 'a',
            img: BaseImg,
          }}
        />
      </div>
    </article>
  </main>
</Layout>

<style is:global>
  .prose-content h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--foreground);
  }
  .prose-content h3 {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--foreground);
  }
  .prose-content p {
    margin-bottom: 1rem;
    line-height: 1.625;
    color: var(--muted-foreground);
  }
  .prose-content pre {
    margin-bottom: 1.5rem;
    overflow-x: auto;
    border-radius: 0.5rem;
    background: var(--muted);
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .prose-content code {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .prose-content ul {
    margin-bottom: 1rem;
    list-style-type: disc;
    padding-left: 1.5rem;
    color: var(--muted-foreground);
  }
  .prose-content ul > :not([hidden]) ~ :not([hidden]) {
    margin-top: 0.25rem;
  }
  .prose-content ol {
    margin-bottom: 1rem;
    list-style-type: decimal;
    padding-left: 1.5rem;
    color: var(--muted-foreground);
  }
  .prose-content ol > :not([hidden]) ~ :not([hidden]) {
    margin-top: 0.25rem;
  }
  .prose-content blockquote {
    margin-bottom: 1rem;
    border-left: 4px solid var(--primary);
    padding-left: 1rem;
    font-style: italic;
    color: var(--muted-foreground);
  }
  .prose-content a {
    color: var(--primary);
    text-decoration: underline;
  }
  .prose-content a:hover {
    text-decoration: none;
  }
  .prose-content img {
    margin-bottom: 1rem;
    border-radius: 0.5rem;
  }
</style>
