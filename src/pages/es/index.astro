---
import Layout from '@/layouts/Layout.astro'
import Hero from '@/components/sections/hero.astro'
import About from '@/components/sections/about.astro'
import ExperienceSection from '@/components/sections/experience.astro'
import EducationSection from '@/components/sections/education.astro'
import Skills from '@/components/sections/skills.astro'
import Projects from '@/components/sections/projects.astro'
import Contact from '@/components/sections/contact.astro'

import profileData from '@/content/profile.json'
import experienceData from '@/content/experience.json'
import educationData from '@/content/education.json'
import skillsData from '@/content/skills.json'
import projectsData from '@/content/projects.json'
import socialLinksData from '@/content/social-links.json'

import type {
  Profile,
  Experience,
  Education,
  SkillGroup,
  Project,
  SocialLink,
} from '@/types'
import { localizeText } from '@/types'

import type { Lang } from '@/i18n/ui'
import { publicAsset } from '@/i18n/utils'

const lang: Lang = 'es'

const profile = profileData as Profile
const experience = experienceData as Experience[]
const education = educationData as Education[]
const skills = skillsData as SkillGroup[]
const projects = projectsData as Project[]
const socialLinks = socialLinksData as SocialLink[]

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: localizeText(profile.title, lang),
  description: localizeText(profile.summary, lang),
  email: `mailto:${profile.email}`,
  image: new URL(publicAsset(profile.avatar), Astro.site).href,
  url: new URL(Astro.url.pathname, Astro.site).href,
  sameAs: socialLinks
    .filter((link) => link.url.startsWith('http'))
    .map((link) => link.url),
}
---

<Layout
  title="Brandom Ledesma — Ingeniero AI Principal & Arquitecto de Software"
  description="Arquitecto de Software e Ingeniero en Nanotecnología enfocado en orquestación de AI, arquitecturas multi-agente y software de producción."
  ogType="website"
  lang={lang}
  jsonLd={jsonLd}
>
  <main id="main" class="mx-auto max-w-5xl px-4">
    <Hero profile={profile} lang={lang} />
    <About lang={lang} />
    <ExperienceSection experience={experience} lang={lang} />
    <EducationSection education={education} lang={lang} />
    <Skills skills={skills} lang={lang} />
    <Projects projects={projects} lang={lang} />
    <Contact socialLinks={socialLinks} email={profile.email} lang={lang} />
  </main>
</Layout>
