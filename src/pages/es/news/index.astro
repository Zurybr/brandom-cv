---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import PostList from '@/components/blog/post-list.astro'
import { computeReadingTime } from '@/lib/utils'
import type { Lang } from '@/i18n/ui'

const lang: Lang = 'es'

const allPosts = await getCollection('news')

const posts = allPosts
  .filter((post) => (post.data.lang || 'en') === lang)
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  )
  .map((post) => ({
    slug: post.id.replace(/-es$/, ''),
    title: post.data.title,
    date: post.data.date.toISOString(),
    category: post.data.category,
    excerpt: post.data.excerpt,
    readingTime: computeReadingTime(post.body || '', lang),
  }))
---

<Layout
  title="Noticias — Brandom Ledesma"
  description="Análisis de mercado y noticias de la industria tecnológica."
  lang={lang}
  hideWaves
>
  <main class="mx-auto max-w-5xl px-4 py-16">
    <h1
      class="mb-8 text-center text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
    >
      Noticias
    </h1>
    <PostList posts={posts} lang={lang} section="news" />
  </main>
</Layout>
