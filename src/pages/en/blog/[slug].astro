---
import { getCollection, render } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import { computeReadingTime } from '@/lib/utils'
import type { Lang } from '@/i18n/ui'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  const enPosts = posts.filter((post) => (post.data.lang || 'en') === 'en')
  return enPosts.map((post) => ({
    params: { slug: post.id.replace(/-en$/, '') },
    props: { post },
  }))
}

const lang: Lang = 'en'
const { post } = Astro.props
const { Content } = await render(post)

const readingTime = computeReadingTime(post.body || '', lang)

const formattedDate = new Date(post.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<Layout
  title={`${post.data.title} — Brandom Ledesma`}
  description={post.data.excerpt}
  ogType="article"
  ogPublishedTime={post.data.date.toISOString()}
  lang={lang}
>
  <main class="mx-auto max-w-3xl px-4 py-16">
    <article>
      <header class="mb-8">
        <h1
          class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
        >
          {post.data.title}
        </h1>
        <div class="mt-3 flex items-center gap-4 text-sm text-muted-foreground">
          <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
          <span>{readingTime}</span>
        </div>
      </header>
      <div class="prose-content">
        <Content
          components={{
            h2: 'h2',
            h3: 'h3',
            p: 'p',
            pre: 'pre',
            code: 'code',
            ul: 'ul',
            ol: 'ol',
            blockquote: 'blockquote',
            a: 'a',
            img: 'img',
          }}
        />
      </div>
    </article>
  </main>
</Layout>

<style is:global>
  .prose-content h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--foreground);
  }
  .prose-content h3 {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--foreground);
  }
  .prose-content p {
    margin-bottom: 1rem;
    line-height: 1.625;
    color: var(--muted-foreground);
  }
  .prose-content pre {
    margin-bottom: 1.5rem;
    overflow-x: auto;
    border-radius: 0.5rem;
    background: var(--muted);
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .prose-content code {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .prose-content ul {
    margin-bottom: 1rem;
    list-style-type: disc;
    padding-left: 1.5rem;
    color: var(--muted-foreground);
  }
  .prose-content ul > :not([hidden]) ~ :not([hidden]) {
    margin-top: 0.25rem;
  }
  .prose-content ol {
    margin-bottom: 1rem;
    list-style-type: decimal;
    padding-left: 1.5rem;
    color: var(--muted-foreground);
  }
  .prose-content ol > :not([hidden]) ~ :not([hidden]) {
    margin-top: 0.25rem;
  }
  .prose-content blockquote {
    margin-bottom: 1rem;
    border-left: 4px solid var(--primary);
    padding-left: 1rem;
    font-style: italic;
    color: var(--muted-foreground);
  }
  .prose-content a {
    color: var(--primary);
    text-decoration: underline;
  }
  .prose-content a:hover {
    text-decoration: none;
  }
  .prose-content img {
    margin-bottom: 1rem;
    border-radius: 0.5rem;
  }
</style>
