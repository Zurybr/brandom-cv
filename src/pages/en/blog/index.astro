---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import PostList from '@/components/blog/post-list.astro'
import { computeReadingTime } from '@/lib/utils'
import type { Lang } from '@/i18n/ui'

const lang: Lang = 'en'

const allPosts = await getCollection('blog')

const posts = allPosts
  .filter((post) => (post.data.lang || 'en') === lang)
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  )
  .map((post) => ({
    slug: post.id.replace(/-en$/, ''),
    title: post.data.title,
    date: post.data.date.toISOString(),
    category: post.data.category,
    excerpt: post.data.excerpt,
    readingTime: computeReadingTime(post.body || '', lang),
  }))
---

<Layout
  title="Blog — Brandom Ledesma"
  description="Deep dives on AI, agents, and the craft of building software that survives production."
  lang={lang}
  hideWaves
>
  <main class="mx-auto max-w-5xl px-4 py-16">
    <h1
      class="mb-3 text-center text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
    >
      Blog
    </h1>
    <p class="mx-auto mb-12 max-w-2xl text-center text-lg text-muted-foreground">
      Deep dives on AI, agents, and the craft of building software that
      survives production.
    </p>
    <PostList posts={posts} lang={lang} />
  </main>
</Layout>
