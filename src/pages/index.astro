---
import type { Lang } from '@/i18n/ui'

const lang: Lang = 'en'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Brandom Ledesma — Portfolio</title>
    <script is:inline define:vars={{ base }}>
      ;(function () {
        let lang = 'en'
        const stored = localStorage.getItem('preferred-lang')
        if (stored === 'es' || stored === 'en') {
          lang = stored
        } else {
          const browserLang = (
            navigator.language ||
            navigator.userLanguage ||
            'en'
          )
            .toLowerCase()
            .substring(0, 2)
          if (browserLang === 'es') {
            lang = 'es'
          }
        }
        window.location.replace(base + '/' + lang + '/')
      })()
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${base}/en/`} />
    </noscript>
  </head>
  <body>
    <p>Redirecting...</p>
  </body>
</html>
