---
import type { SkillGroup } from '@/types'
import SectionHeading from '@/components/ui/section-heading.astro'
import Badge from '@/components/ui/badge.astro'

interface Props {
  skills: SkillGroup[]
}

const { skills } = Astro.props
---

<section id="skills" class="py-16">
  <SectionHeading title="Habilidades" />
  <div class="mx-auto max-w-4xl space-y-8">
    {
      skills.map((group, gi) => (
        <div data-animate="fade-up" style={`animation-delay: ${gi * 100}ms`}>
          <h3 class="mb-3 text-lg font-semibold text-foreground">
            {group.category}
          </h3>
          <div data-stagger class="flex flex-wrap gap-2">
            {group.items.map((item, i) => (
              <span
                style={`--stagger-i: ${i}`}
                class="inline-block rounded-full bg-muted px-3 py-1 text-sm font-medium text-muted-foreground"
              >
                {item}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
