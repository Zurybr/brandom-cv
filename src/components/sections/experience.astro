---
import type { Experience } from '@/types'
import SectionHeading from '@/components/ui/section-heading.astro'
import Badge from '@/components/ui/badge.astro'

interface Props {
  experience: Experience[]
}

const { experience } = Astro.props
---

<section id="experience" class="py-16">
  <SectionHeading title="Experiencia" />
  <div class="mx-auto max-w-3xl space-y-8">
    {
      experience.map((exp, i) => (
        <div
          data-animate="slide-in-left"
          style={`animation-delay: ${i * 150}ms`}
          class="relative border-l-2 border-primary pl-6"
        >
          <div class="absolute -left-[7px] top-0 h-3 w-3 rounded-full bg-primary" />
          <h3 class="text-xl font-semibold text-foreground">{exp.role}</h3>
          <p class="text-sm font-medium text-primary">
            {exp.company} &middot; {exp.period}
          </p>
          <p class="mt-2 leading-relaxed text-muted-foreground">
            {exp.description}
          </p>
          {exp.technologies.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {exp.technologies.map((tech, j) => (
                <Badge text={tech} />
              ))}
            </div>
          )}
        </div>
      ))
    }
  </div>
</section>
