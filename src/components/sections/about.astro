---
import SectionHeading from '@/components/ui/section-heading.astro'

interface Props {
  summary: string
}

const { summary } = Astro.props
---

<section id="about" class="py-16">
  <SectionHeading title="Sobre Mí" />
  <div data-animate="fade-up" class="mx-auto max-w-3xl text-center">
    <p class="text-lg leading-relaxed text-muted-foreground">
      {summary}
    </p>
  </div>
</section>
