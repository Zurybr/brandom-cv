---
import type { Lang } from '@/i18n/ui'
import type { Bilingual } from '@/types'
import { useTranslations } from '@/i18n/utils'
import { localizeText } from '@/types'
import SectionHeading from '@/components/ui/section-heading.astro'

interface Props {
  summary: string | Bilingual
  lang: Lang
}

const { summary, lang } = Astro.props
const t = useTranslations(lang)
---

<section id="about" class="py-16">
  <SectionHeading title={t('section.about')} />
  <div data-animate="fade-up" class="mx-auto max-w-3xl text-center">
    <p class="text-lg leading-relaxed text-muted-foreground">
      {localizeText(summary, lang)}
    </p>
  </div>
</section>
