---
import type { Project } from '@/types'
import type { Lang } from '@/i18n/ui'
import SectionHeading from '@/components/ui/section-heading.astro'
import Card from '@/components/ui/card.astro'
import Badge from '@/components/ui/badge.astro'
import IconLink from '@/components/ui/icon-link.astro'
import { useTranslations } from '@/i18n/utils'

interface Props {
  projects: Project[]
  lang: Lang
}

const { projects, lang } = Astro.props
const t = useTranslations(lang)
---

<section id="projects" class="py-16">
  <SectionHeading title={t('section.projects')} />
  {
    projects.length === 0 ? (
      <p class="text-center text-muted-foreground">
        {t('section.projects.empty')}
      </p>
    ) : (
      <div class="mx-auto grid max-w-4xl gap-6 sm:grid-cols-2">
        {projects
          .filter((p) => p.featured !== false)
          .map((project) => (
            <Card>
              <h3 class="text-xl font-semibold text-foreground">
                {project.title}
              </h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">
                {project.description}
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                {project.technologies.map((tech) => (
                  <Badge text={tech} />
                ))}
              </div>
              <div class="mt-4 flex gap-4">
                {project.liveUrl && (
                  <IconLink
                    href={project.liveUrl}
                    icon="globe"
                    label={t('section.projects.demo')}
                    external
                  />
                )}
                {project.repoUrl && (
                  <IconLink
                    href={project.repoUrl}
                    icon="github"
                    label={t('section.projects.code')}
                    external
                  />
                )}
              </div>
            </Card>
          ))}
      </div>
    )
  }
</section>
