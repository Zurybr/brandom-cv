---
import type { SocialLink } from '@/types'
import type { Lang } from '@/i18n/ui'
import SectionHeading from '@/components/ui/section-heading.astro'
import IconLink from '@/components/ui/icon-link.astro'
import { useTranslations } from '@/i18n/utils'

interface Props {
  socialLinks: SocialLink[]
  email: string
  lang: Lang
}

const { socialLinks, email, lang } = Astro.props
const t = useTranslations(lang)
---

<section id="contact" class="py-16">
  <SectionHeading title={t('section.contact')} subtitle={t('section.contact.subtitle')} />
  <div data-animate="fade-up" class="mx-auto max-w-3xl text-center">
    <p class="mb-6 text-muted-foreground">
      {t('section.contact.text')}
    </p>
    <div class="flex flex-wrap justify-center gap-6">
      {
        socialLinks.map((link) => (
          <IconLink
            href={link.url}
            icon={link.icon}
            label={link.platform}
            external={link.icon !== 'mail'}
          />
        ))
      }
    </div>
    <p class="mt-6">
      <a
        href={`mailto:${email}`}
        class="text-primary underline-offset-4 hover:underline"
      >
        {email}
      </a>
    </p>
  </div>
</section>
