---
import type { Profile } from '@/types'

interface Props {
  profile: Profile
}

const { profile } = Astro.props
---

<section
  class="flex flex-col items-center gap-8 py-16 sm:py-24 md:flex-row md:gap-16 md:py-32"
>
  <div class="flex-shrink-0" data-animate="scale-in" style="animation-delay: 0ms">
    <img
      src={profile.avatar}
      alt={`Foto de ${profile.name}`}
      width="200"
      height="200"
      class="animate-avatar-pulse rounded-full border-4 border-primary object-cover"
    />
  </div>
  <div class="text-center md:text-left">
    <h1
      data-animate="fade-up"
      style="animation-delay: 150ms"
      class="text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-6xl"
    >
      {profile.name}
    </h1>
    <p
      data-animate="fade-up"
      style="animation-delay: 250ms"
      class="mt-3 text-xl font-medium text-primary sm:text-2xl"
    >
      {profile.title}
    </p>
    <p
      data-animate="fade-up"
      style="animation-delay: 350ms"
      class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground"
    >
      {profile.summary}
    </p>
    <p
      data-animate="fade-up"
      style="animation-delay: 450ms"
      class="mt-3 text-sm text-muted-foreground"
    >
      {profile.location}
    </p>
  </div>
</section>
