---
import type { Profile } from '@/types'
import type { Lang } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'

interface Props {
  profile: Profile
  lang: Lang
}

const { profile, lang } = Astro.props
const t = useTranslations(lang)
---

<section
  class="flex flex-col items-center gap-8 py-16 sm:py-24 md:flex-row md:gap-16 md:py-32"
>
  <div id="hero-avatar-wrapper" class="avatar-wrapper" data-animate="scale-in" style="animation-delay: 0ms">
    <img
      src={profile.avatar}
      alt={`${t('hero.photoAlt')} ${profile.name}`}
      width="200"
      height="200"
      class="avatar-image rounded-full border-4 border-primary object-cover"
    />
  </div>
  <div class="text-center md:text-left">
    <h1
      data-animate="fade-up"
      style="animation-delay: 150ms"
      class="text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-6xl"
    >
      {profile.name}
    </h1>
    <p
      data-animate="fade-up"
      style="animation-delay: 250ms"
      class="mt-3 text-xl font-medium text-primary sm:text-2xl"
    >
      {profile.title}
    </p>
    <p
      data-animate="fade-up"
      style="animation-delay: 350ms"
      class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground"
    >
      {profile.summary}
    </p>
    <p
      data-animate="fade-up"
      style="animation-delay: 450ms"
      class="mt-3 text-sm text-muted-foreground"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mr-1.5 inline-block -mt-0.5"
        aria-hidden="true"
      >
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      {profile.location}
    </p>
  </div>
</section>
