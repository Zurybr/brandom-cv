---
import type { Education } from '@/types'
import type { Lang } from '@/i18n/ui'
import SectionHeading from '@/components/ui/section-heading.astro'
import Card from '@/components/ui/card.astro'
import { useTranslations } from '@/i18n/utils'
import { localizeText } from '@/types'

interface Props {
  education: Education[]
  lang: Lang
}

const { education, lang } = Astro.props
const t = useTranslations(lang)
---

<section id="education" class="py-16">
  <SectionHeading title={t('section.education')} />
  <div class="mx-auto max-w-3xl space-y-6">
    {
      education.map((edu, i) => (
        <div data-animate="fade-up" style={`animation-delay: ${i * 150}ms`}>
          <Card>
            <h3 class="text-xl font-semibold text-foreground">
              {edu.institution}
            </h3>
            <p class="mt-1 text-primary">{localizeText(edu.degree, lang)}</p>
            <p class="mt-1 text-sm text-muted-foreground">{localizeText(edu.period, lang)}</p>
            {edu.description && (
              <p class="mt-3 leading-relaxed text-muted-foreground">
                {localizeText(edu.description, lang)}
              </p>
            )}
          </Card>
        </div>
      ))
    }
  </div>
</section>
