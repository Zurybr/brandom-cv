---
import { getLangFromUrl, switchLocalePath } from '@/i18n/utils'

const currentLang = getLangFromUrl(Astro.url)
const currentUrl = Astro.url
---

<div class="flex items-center gap-1 rounded-lg border border-border p-0.5">
  <a
    href={switchLocalePath(currentUrl, 'en')}
    class:list={[
      'flex items-center gap-1.5 rounded-md px-2.5 py-1 text-sm font-medium transition-colors',
      currentLang === 'en'
        ? 'bg-primary text-primary-foreground'
        : 'text-muted-foreground hover:bg-muted hover:text-foreground',
    ]}
    title="English"
    aria-label="English"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="12" viewBox="0 0 16 12" class="shrink-0">
      <rect width="16" height="12" fill="#B22234"/>
      <path d="M0 1.8h16M0 3.6h16M0 5.4h16M0 7.2h16M0 9h16M0 10.8h16" stroke="#fff" stroke-width="1.2"/>
      <rect width="6.4" height="6.6" fill="#3C3B6E"/>
    </svg>
    EN
  </a>
  <a
    href={switchLocalePath(currentUrl, 'es')}
    class:list={[
      'flex items-center gap-1.5 rounded-md px-2.5 py-1 text-sm font-medium transition-colors',
      currentLang === 'es'
        ? 'bg-primary text-primary-foreground'
        : 'text-muted-foreground hover:bg-muted hover:text-foreground',
    ]}
    title="Español"
    aria-label="Español"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="12" viewBox="0 0 16 12" class="shrink-0">
      <rect width="5.33" height="12" fill="#006341"/>
      <rect width="5.33" height="12" x="5.33" fill="#FFFFFF"/>
      <rect width="5.34" height="12" x="10.66" fill="#CE1126"/>
    </svg>
    ES
  </a>
</div>
