---
import LanguageSelector from '@/components/ui/language-selector.astro'
import type { Lang } from '@/i18n/ui'
import { getLangFromUrl, useTranslations, publicAsset } from '@/i18n/utils'

const lang: Lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const home = `${base}/${lang}/`
// Section anchors live on the home page; from any subpage, link back to home + hash
const at = (hash: string) => (Astro.url.pathname.replace(new RegExp(`^${base}`), '') === `/${lang}/` ? hash : home + hash)
---
<div class="brand-band" id="top">
  <div class="container">
    <div class="brand-band-frame">
      <span class="corner tl"></span>
      <span class="corner br"></span>
      <img src={publicAsset('/images/profile.png')} alt="Brandom Rafael Ledesma Muñoz" width="96" height="96" class="brand-photo" />
    </div>
    <div class="brand-band-note">
      <span>Inicio &nbsp;·&nbsp; Brandom Ledesma / 2026 / Vol. 01</span>
      <span>001 / 007</span>
    </div>
  </div>
</div>
<div class="topbar">
  <div class="container topbar-inner">
    <span><b>BL / 2026</b> &nbsp;·&nbsp; <span set:html={t('ed.docMeta')} /></span>
    <span class="mid">
      <span set:html={t('ed.topbarSpecialty')} />
      <span set:html={t('ed.topbarClaim')} />
    </span>
    <span class="right">
      <a class="topbar-link" href={at('#contacto')}><span class="pulse"></span>{t('ed.topbarStatus')}</a>
      <LanguageSelector />
    </span>
  </div>
</div>
<header class="nav">
  <div class="container nav-inner">
    <nav aria-label={t('nav.main')}>
      <ul class="nav-links">
        <li><a href={at('#top')}><span class="num">01</span>{t('nav.home')}</a></li>
        <li><a href={at('#perfil')}><span class="num">02</span>{t('section.about')}</a></li>
        <li><a href={at('#proyectos')}><span class="num">03</span>{t('section.projects')}</a></li>
        <li><a href={at('#experiencia')}><span class="num">04</span>{t('section.experience')}</a></li>
        <li><a href={at('#formacion')}><span class="num">05</span>{t('section.education')}</a></li>
        <li><a href={at('#stack')}><span class="num">06</span>{t('section.skills')}</a></li>
        <li><a href={at('#contacto')}><span class="num">07</span>{t('section.contact')}</a></li>
      </ul>
    </nav>
  </div>
</header>
