---
import LanguageSelector from '@/components/ui/language-selector.astro'
import { getLangFromUrl, useTranslations, useTranslatedPath, publicAsset } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)

const navLinks = [
  { href: translatePath('/'), label: t('nav.home') },
  { href: translatePath('/blog'), label: t('nav.blog') },
  { href: translatePath('/news'), label: t('nav.news') },
]

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '')
const currentPath = Astro.url.pathname.replace(new RegExp(`^${basePath}`), '') || '/'
---

<header
  class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur"
>
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3"
    aria-label={t('nav.main')}
  >
    <a
      href={translatePath('/')}
      class="flex items-center gap-2 text-lg font-bold text-foreground transition-colors hover:text-primary"
    >
      <span id="nav-avatar" class="nav-avatar">
        <img
          src={publicAsset('/images/profile.png')}
          alt=""
          width="36"
          height="36"
          class="h-9 w-9 rounded-full border-2 border-primary object-cover sm:h-9 sm:w-9"
        />
      </span>
      BL
    </a>

    <div class="hidden items-center gap-4 sm:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium transition-colors hover:text-primary',
              currentPath === link.href
                ? 'text-primary'
                : 'text-muted-foreground',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <LanguageSelector />
    </div>

    <div class="flex items-center gap-2 sm:hidden">
      <LanguageSelector />
      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t('nav.menu.open')}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="border-t border-border sm:hidden hidden">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'block px-4 py-3 text-sm font-medium transition-colors hover:text-primary',
            currentPath === link.href
              ? 'text-primary'
              : 'text-muted-foreground',
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </div>
</header>

<script is:inline>
  const toggle = document.getElementById('menu-toggle')
  const menu = document.getElementById('mobile-menu')

  function setMenuOpen(open) {
    if (!toggle || !menu) return
    menu.classList.toggle('hidden', !open)
    toggle.setAttribute('aria-expanded', String(open))
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú')
    toggle.querySelector('svg').innerHTML = open
      ? '<path d="M18 6 6 18M6 6l12 12"></path>'
      : '<line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line>'
    if (open) {
      const firstLink = menu.querySelector('a')
      firstLink && firstLink.focus()
    }
  }

  toggle &&
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true'
      setMenuOpen(!isOpen)
    })

  document.addEventListener('keydown', (e) => {
    if (
      e.key === 'Escape' &&
      toggle &&
      toggle.getAttribute('aria-expanded') === 'true'
    ) {
      setMenuOpen(false)
      toggle.focus()
    }
  })
</script>
