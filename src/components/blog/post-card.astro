---
import Card from '@/components/ui/card.astro'
import Badge from '@/components/ui/badge.astro'
import type { Lang } from '@/i18n/ui'
import { getLocalizedPath } from '@/i18n/utils'

interface Props {
  slug: string
  title: string
  date: string
  category?: string
  excerpt: string
  readingTime: string
  lang: Lang
  section?: string
}

const { slug, title, date, category, excerpt, readingTime, lang, section = 'blog' } = Astro.props

const locale = lang === 'es' ? 'es-MX' : 'en-US'

const formattedDate = new Date(date).toLocaleDateString(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})

const href = getLocalizedPath(`/${section}/${slug}`, lang)
---

<a href={href} class="group block h-full">
  <Card
    className="h-full transition-all duration-300 hover:-translate-y-1 hover:border-primary hover:shadow-lg"
  >
    <div class="flex items-center gap-3 text-sm text-muted-foreground">
      <time datetime={date}>{formattedDate}</time>
      {category && <Badge text={category} />}
    </div>
    <h3 class="mt-2 text-xl font-semibold text-foreground">
      {title}
    </h3>
    <p class="mt-2 leading-relaxed text-muted-foreground">
      {excerpt}
    </p>
    <div class="mt-3 flex items-center justify-between text-sm text-primary">
      <span>{readingTime}</span>
      <span
        class="transition-transform duration-300 group-hover:translate-x-1"
        aria-hidden="true">→</span
      >
    </div>
  </Card>
</a>
