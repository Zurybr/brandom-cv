---
import PostCard from '@/components/blog/post-card.astro'
import type { Lang } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'

interface Props {
  posts: Array<{
    slug: string
    title: string
    date: string
    category?: string
    excerpt: string
    readingTime: string
  }>
  lang: Lang
  section?: string
}

const { posts, lang, section = 'blog' } = Astro.props
const t = useTranslations(lang)
---

{
  posts.length === 0 ? (
    <p class="py-12 text-center text-muted-foreground">
      {t('blog.empty')}
    </p>
  ) : (
    <div class="grid gap-6 sm:grid-cols-2">
      {posts.map((post, i) => (
        <div class="h-full" data-animate="wave-rise" style={`animation-delay: ${i * 90}ms`}>
          <PostCard {...post} lang={lang} section={section} />
        </div>
      ))}
    </div>
  )
}
