---
import Header from '@/components/layout/header.astro'
import Footer from '@/components/layout/footer.astro'
import FluidBackground from '@/components/fluid-background.astro'
import socialLinksData from '@/content/social-links.json'
import type { SocialLink } from '@/types'
import type { Lang } from '@/i18n/ui'
import { getLangFromUrl, useTranslations, useTranslatedPath } from '@/i18n/utils'

interface Props {
  title?: string
  description?: string
  ogType?: string
  ogPublishedTime?: string
  lang?: Lang
  hideWaves?: boolean
}

const {
  title = 'Brandom Ledesma — Portfolio',
  description = 'Portfolio and blog of Brandom Ledesma, Principal AI Engineer & Software Architect.',
  ogType = 'website',
  ogPublishedTime,
  lang,
  hideWaves = false,
} = Astro.props

const currentLang = lang || getLangFromUrl(Astro.url)
const t = useTranslations(currentLang)
const translatePath = useTranslatedPath(currentLang)

const socialLinks = socialLinksData as SocialLink[]
import '@/styles/global.css'
---

<html lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:locale" content={currentLang === 'es' ? 'es_MX' : 'en_US'} />
    {
      ogPublishedTime && (
        <meta property="article:published_time" content={ogPublishedTime} />
      )
    }
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-screen flex flex-col">
    { !hideWaves && <FluidBackground /> }
    <Header />
    <div class="flex-1">
      <slot />
    </div>
    <Footer socialLinks={socialLinks} />
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible')
              observer.unobserve(entry.target)
            }
          })
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      )

      document.querySelectorAll('[data-animate], [data-stagger]').forEach((el) => {
        observer.observe(el)
      })
    </script>
    <script is:inline>
      ;(function () {
        var heroWrapper = document.getElementById('hero-avatar-wrapper')
        var navAvatar = document.getElementById('nav-avatar')
        if (!heroWrapper || !navAvatar) return

        var scrollObserver = new IntersectionObserver(
          function ([entry]) {
            var inNav = !entry.isIntersecting
            navAvatar.classList.toggle('is-visible', inNav)
            heroWrapper.classList.toggle('is-in-nav', inNav)
          },
          {
            threshold: 0,
            rootMargin: '-80px 0px 0px 0px',
          }
        )

        scrollObserver.observe(heroWrapper)
      })()
    </script>
  </body>
</html>
