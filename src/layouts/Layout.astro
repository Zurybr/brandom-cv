---
import Header from '@/components/layout/header.astro'
import Footer from '@/components/layout/footer.astro'
import VisitorTracker from '@/components/visitor-tracker.astro'
import socialLinksData from '@/content/social-links.json'
import type { SocialLink } from '@/types'
import type { Lang } from '@/i18n/ui'
import { getLangFromUrl, useTranslations, switchLocalePath, publicAsset } from '@/i18n/utils'
import '@/styles/global.css'

interface Props {
  title?: string
  description?: string
  ogType?: string
  ogPublishedTime?: string
  lang?: Lang
  jsonLd?: Record<string, unknown>
}

const {
  title = 'Brandom Ledesma — Software & AI Systems Engineer',
  description = 'Curriculum vitae of Brandom Ledesma: software architect and AI systems engineer. Multi-agent architectures, event-driven platforms and full-stack software in production.',
  ogType = 'website',
  ogPublishedTime,
  lang,
  jsonLd,
} = Astro.props

const currentLang = lang || getLangFromUrl(Astro.url)
const t = useTranslations(currentLang)

const socialLinks = socialLinksData as SocialLink[]

const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const ogImageUrl = new URL(publicAsset('/images/profile.png'), Astro.site)

// hreflang alternates only exist for localized routes (/en/*, /es/*)
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '')
const pathWithoutBase = Astro.url.pathname.replace(new RegExp(`^${basePath}`), '')
const hasLocaleRoute = /^\/(en|es)(\/|$)/.test(pathWithoutBase)
const alternates = hasLocaleRoute
  ? (['en', 'es'] as const).map((altLang) => ({
      hreflang: altLang,
      href: new URL(switchLocalePath(Astro.url, altLang), Astro.site).href,
    }))
  : []
---

<html lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Brandom Rafael Ledesma Muñoz" />
    <link rel="canonical" href={canonicalUrl.href} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    {
      alternates.length > 0 && (
        <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
      )
    }
    <link rel="sitemap" href={publicAsset('/sitemap-index.xml')} />
    <link rel="icon" type="image/png" href={publicAsset('/images/profile.png')} />
    <link rel="apple-touch-icon" href={publicAsset('/images/profile.png')} />
    <meta name="theme-color" content="#232C33" />
    <meta property="og:site_name" content="Brandom Ledesma" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:locale" content={currentLang === 'es' ? 'es_MX' : 'en_US'} />
    {
      ogPublishedTime && (
        <meta property="article:published_time" content={ogPublishedTime} />
      )
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <meta name="generator" content={Astro.generator} />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>
  <body>
    <canvas id="bg3d" aria-hidden="true"></canvas>
    <div class="side-rail right" aria-hidden="true">
      <span class="rail-text" set:html={t('ed.railRight')} />
    </div>
    <div class="side-rail left" aria-hidden="true">
      <span class="rail-text" set:html={t('ed.railLeft')} />
    </div>
    <a href="#main" class="skip-link">{t('nav.skip')}</a>
    <div class="shell">
      <Header />
      <div class="flex-1">
        <slot />
      </div>
      <Footer socialLinks={socialLinks} />
    </div>
    <VisitorTracker />
    <script>
      // Reveal-on-scroll: flips data-revealed as sections enter the viewport
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.setAttribute('data-revealed', 'true')
              // Safety net: guarantee final state even if CSS transitions freeze
              window.setTimeout(() => {
                const el = entry.target as HTMLElement
                el.style.opacity = '1'
                el.style.transform = 'none'
              }, 950)
              observer.unobserve(entry.target)
            }
          })
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      )
      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el))
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('[data-reveal]').forEach((el) => el.setAttribute('data-revealed', 'true'))
      }
    </script>
    <script>
      // 3D backdrop: sparse dust constellation in perspective, pure canvas 2D
      ;(function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
        const canvas = document.getElementById('bg3d') as HTMLCanvasElement | null
        if (!canvas) return
        const ctx = canvas.getContext('2d')
        if (!ctx) return
        const dpr = Math.min(window.devicePixelRatio || 1, 2)
        let W = 0, H = 0
        const mouse = { x: 0, y: 0 }
        const reduceTransparency = window.matchMedia('(prefers-reduced-transparency: reduce)').matches
        const COUNT = reduceTransparency ? 0 : 80
        const COLORS = ['255,255,255', '185,199,206', '120,150,165']
        const pts: { x: number; y: number; z: number; r: number; glow: boolean; c: string; a: number }[] = []
        for (let i = 0; i < COUNT; i++) {
          const glow = Math.random() < 0.14
          pts.push({
            x: (Math.random() - 0.5) * 2,
            y: (Math.random() - 0.5) * 2,
            z: Math.random() * 2 - 1,
            r: 0.6 + Math.random() * 1.8,
            glow,
            c: COLORS[Math.floor(Math.random() * COLORS.length)],
            a: glow ? 0.05 + Math.random() * 0.04 : 0.08 + Math.random() * 0.1,
          })
        }
        function resize() {
          W = window.innerWidth
          H = window.innerHeight
          canvas!.width = W * dpr
          canvas!.height = H * dpr
          canvas!.style.width = W + 'px'
          canvas!.style.height = H + 'px'
          ctx!.setTransform(dpr, 0, 0, dpr, 0, 0)
        }
        function frame(t: number) {
          const time = t * 0.00006
          ctx!.clearRect(0, 0, W, H)
          const fov = Math.min(W, H) * 0.9
          const cx = W / 2 + mouse.x * 14
          const cy = H / 2 + mouse.y * 10
          for (const p of pts) {
            const ang = time + p.x * 2.1
            const x = p.x * Math.cos(ang) - p.z * Math.sin(ang)
            const z = p.x * Math.sin(ang) + p.z * Math.cos(ang) + 2.6
            const y = p.y + Math.sin(time * 1.7 + p.z * 3) * 0.06
            const s = fov / z
            const px = cx + x * s
            const py = cy + y * s
            if (px < -140 || px > W + 140 || py < -140 || py > H + 140) continue
            const rad = Math.min(p.r * (p.glow ? 46 : 2.4) * (2.6 / z), p.glow ? 120 : 4.5)
            ctx!.beginPath()
            ctx!.arc(px, py, rad, 0, Math.PI * 2)
            ctx!.fillStyle = 'rgba(' + p.c + ',' + p.a + ')'
            ctx!.fill()
          }
          requestAnimationFrame(frame)
        }
        window.addEventListener('resize', resize)
        window.addEventListener('mousemove', (e) => {
          mouse.x = (e.clientX / W - 0.5) * 2
          mouse.y = (e.clientY / H - 0.5) * 2
        }, { passive: true })
        resize()
        requestAnimationFrame(frame)
      })()
    </script>
  </body>
</html>
