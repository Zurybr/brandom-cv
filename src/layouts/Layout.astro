---
import Header from '@/components/layout/header.astro'
import Footer from '@/components/layout/footer.astro'
import FluidBackground from '@/components/fluid-background.astro'
import VisitorTracker from '@/components/visitor-tracker.astro'
import socialLinksData from '@/content/social-links.json'
import type { SocialLink } from '@/types'
import type { Lang } from '@/i18n/ui'
import { getLangFromUrl, useTranslations, switchLocalePath, publicAsset } from '@/i18n/utils'
import '@/styles/global.css'

interface Props {
  title?: string
  description?: string
  ogType?: string
  ogPublishedTime?: string
  lang?: Lang
  jsonLd?: Record<string, unknown>
}

const {
  title = 'Brandom Ledesma — Portfolio',
  description = 'Portfolio and blog of Brandom Ledesma, Principal AI Engineer & Software Architect.',
  ogType = 'website',
  ogPublishedTime,
  lang,
  jsonLd,
} = Astro.props

const currentLang = lang || getLangFromUrl(Astro.url)
const t = useTranslations(currentLang)

const socialLinks = socialLinksData as SocialLink[]

const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const ogImageUrl = new URL(publicAsset('/images/profile.png'), Astro.site)

// hreflang alternates only exist for localized routes (/en/*, /es/*)
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '')
const pathWithoutBase = Astro.url.pathname.replace(new RegExp(`^${basePath}`), '')
const hasLocaleRoute = /^\/(en|es)(\/|$)/.test(pathWithoutBase)
const alternates = hasLocaleRoute
  ? (['en', 'es'] as const).map((altLang) => ({
      hreflang: altLang,
      href: new URL(switchLocalePath(Astro.url, altLang), Astro.site).href,
    }))
  : []
---

<html lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    {
      alternates.length > 0 && (
        <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
      )
    }
    <link rel="sitemap" href={publicAsset('/sitemap-index.xml')} />
    <link rel="icon" type="image/png" href={publicAsset('/images/profile.png')} />
    <link rel="apple-touch-icon" href={publicAsset('/images/profile.png')} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0a" />
    <meta property="og:site_name" content="Brandom Ledesma" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:locale" content={currentLang === 'es' ? 'es_MX' : 'en_US'} />
    {
      ogPublishedTime && (
        <meta property="article:published_time" content={ogPublishedTime} />
      )
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <meta name="generator" content={Astro.generator} />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">{t('nav.skip')}</a>
    <div class="ambient-glow" aria-hidden="true"></div>
    <FluidBackground />
    <Header />
    <div class="flex-1">
      <slot />
    </div>
    <Footer socialLinks={socialLinks} />
    <VisitorTracker />
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible')
              observer.unobserve(entry.target)
            }
          })
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      )

      document.querySelectorAll('[data-animate], [data-stagger]').forEach((el) => {
        observer.observe(el)
      })
    </script>
    <script is:inline>
      ;(function () {
        var heroWrapper = document.getElementById('hero-avatar-wrapper')
        var navAvatar = document.getElementById('nav-avatar')
        if (!heroWrapper || !navAvatar) return

        var scrollObserver = new IntersectionObserver(
          function ([entry]) {
            var inNav = !entry.isIntersecting
            navAvatar.classList.toggle('is-visible', inNav)
            heroWrapper.classList.toggle('is-in-nav', inNav)
          },
          {
            threshold: 0,
            rootMargin: '-80px 0px 0px 0px',
          }
        )

        scrollObserver.observe(heroWrapper)
      })()
    </script>
  </body>
</html>
